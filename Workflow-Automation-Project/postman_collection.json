{
  "info": {
    "name": "Workflow Automation System API",
    "description": "Complete API collection for testing the Workflow Automation System with authentication and task management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"employee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Task Management",
      "item": [
        {
          "name": "Create Task (Admin/Manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete project documentation\",\n  \"description\": \"Write comprehensive documentation for the workflow system\",\n  \"assignedTo\": \"USER_ID_HERE\",\n  \"metadata\": {\n    \"priority\": \"high\",\n    \"deadline\": \"2024-12-31\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "create"]
            }
          }
        },
        {
          "name": "View My Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/view",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "view"]
            }
          }
        },
        {
          "name": "Update Task State (Admin/Manager)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/:taskId/transition",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ":taskId", "transition"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "TASK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Tasks (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "all"]
            }
          }
        },
        {
          "name": "Delete Task (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/:taskId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ":taskId"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "TASK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get Task Summary (Admin/Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "summary"]
            }
          }
        },
        {
          "name": "Get User Task Statistics (Admin/Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/user-stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "user-stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/check",
              "host": ["{{baseUrl}}"],
              "path": ["check"]
            }
          }
        },
        {
          "name": "API Routes Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": ["{{baseUrl}}"],
              "path": ["routes"]
            }
          }
        }
      ]
    }
  ]
}
